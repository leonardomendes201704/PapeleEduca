{
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    },
    {
      "source": "/blog/brincar-interagir-aprender-bncc.html",
      "destination": "/blog/brincar-interagir-aprender-bncc",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog/render?slug=:slug"
    }
  ]
}
